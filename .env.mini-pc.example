# Backend autoalojado de IsiVoltPro Activos.
# No reutilizar URL, usuarios ni credenciales de HomeServe.
VITE_BACKEND_MODE=self-hosted
VITE_SUPABASE_URL=https://api.activos.isivoltpro.com
VITE_SUPABASE_PUBLISHABLE_KEY=PEGA_AQUI_LA_CLAVE_PUBLICA_GENERADA_EN_EL_MINI_PC
VITE_ENABLE_DEMO_SIGNUP=false

# La web solo escucha en localhost; Cloudflare Tunnel la publica por HTTPS.
ACTIVOS_WEB_BIND=127.0.0.1
ACTIVOS_WEB_PORT=5175
